{
  "name": "fukugyononuko-homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force && node scripts/subset-heading-font.mjs",
    "preview": "astro preview",
    "lint": "astro check",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs && node scripts/check-astro-imports.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:images": "node scripts/check-image-metadata.mjs",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:budget": "node scripts/check-asset-budget.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "@types/js-yaml": "^4.0.9",
    "dependency-cruiser": "^18.6.0",
    "lighthouse": "^13.5.0",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "fsevents": false
  }
}
