{
  "name": "fukugyononuko-homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "astro check",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs && node scripts/check-astro-imports.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:images": "node scripts/check-image-metadata.mjs",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "check:privacy": "node scripts/check-privacy.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "astro": "^7.3.8",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/js-yaml": "^4.0.9",
    "dependency-cruiser": "^18.5.0",
    "lighthouse": "^13.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "fsevents": false
  }
}
