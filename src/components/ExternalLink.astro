---
// CMP-C01 外部リンクはこのコンポーネントだけで出力する（NFR-16、DD-11）
import type { HTMLAttributes } from "astro/types";
type Props = Omit<HTMLAttributes<"a">, "target" | "rel"> & { href: string };
const { href, class: className, ...rest } = Astro.props;
---
<a href={href} class={className} target="_blank" rel="noopener noreferrer" {...rest}><slot /><span class="visually-hidden">（新しいタブで開きます）</span></a>
