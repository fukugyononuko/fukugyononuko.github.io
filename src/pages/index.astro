---
// CMP-C01 Pages / SCR-01 トップ（DD-11、CC-01、FR-09）
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Section from "../components/Section.astro";
import ServiceCard from "../components/ServiceCard.astro";
import WorkList from "../components/WorkList.astro";
import { showcase } from "../system/compose";

const view = await showcase.getHomeView();
---
<BaseLayout meta={view.meta}>
  <section class="hero">
    <div class="photo">
      <img
        src="/images/hero-1600.webp"
        srcset="/images/hero-800.webp 800w, /images/hero-1600.webp 1600w"
        sizes="(min-width: 64rem) 64rem, 100vw"
        width="1600"
        height="1066"
        alt="木漏れ日の砂浜で休むカモメ"
        fetchpriority="high"
      />
    </div>
    <div class="container intro">
      <h1>{view.profile.displayName}</h1>
      <p class="tagline">{view.profile.tagline}</p>
      <div class="actions">
        <Button href="/services/">サービスを見る</Button>
        <Button href="/contact/" variant="secondary">問い合わせる</Button>
      </div>
    </div>
  </section>

  {view.featuredSkills.length > 0 && (
    <Section id="skills" heading="できること">
      <ul class="skills">
        {view.featuredSkills.map((s) => (
          <li>
            <span class="skill-name">{s.name}</span>
            {s.description && <span class="skill-desc">{s.description}</span>}
          </li>
        ))}
      </ul>
      <p class="more"><a href="/about/">プロフィールとできることの一覧へ</a></p>
    </Section>
  )}

  <Section id="services" heading="サービス">
    {view.featuredServices.length > 0 ? (
      <ul class="cards">
        {view.featuredServices.map((s) => <li><ServiceCard service={s} /></li>)}
      </ul>
    ) : (
      <p>サービスは準備中です。ご相談は<a href="/contact/">問い合わせ</a>からどうぞ。</p>
    )}
    <p class="more"><a href="/services/">サービスの一覧へ</a></p>
  </Section>

  {view.featuredWorks.length > 0 && (
    <Section id="works" heading="制作例">
      <WorkList works={view.featuredWorks} />
    </Section>
  )}
</BaseLayout>

<style>
  .hero {
    padding-bottom: var(--space-8);
  }
  .photo {
    max-width: var(--content-width);
    margin: var(--space-4) auto 0;
    padding-inline: var(--gutter);
  }
  .photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 30% 65%;
    border-radius: var(--radius-l);
    box-shadow: 0 8px 32px var(--color-shadow);
  }
  @media (min-width: 40rem) {
    .photo img {
      aspect-ratio: 16 / 9;
      object-position: 35% 60%;
    }
  }
  @media (prefers-color-scheme: dark) {
    .photo img {
      filter: brightness(0.9);
    }
  }
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: var(--space-8);
  }
  h1 {
    margin: 0 0 var(--space-2);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }
  .tagline {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: 1.125rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .skills {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }
  .skills li {
    display: flex;
    flex-direction: column;
    padding: var(--space-4) var(--space-6);
    background: var(--color-sunken);
    border-radius: var(--radius-m);
  }
  .skill-name {
    font-weight: 700;
  }
  .skill-desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }
  .cards {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }
  .more {
    margin: var(--space-4) 0 0;
    text-align: right;
  }
  :global(section[aria-labelledby="works"] .works) {
    margin-top: var(--space-6);
  }
</style>
