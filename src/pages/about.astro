---
// CMP-C01 Pages / SCR-02 About（DD-11、CC-02、FR-01〜FR-03）
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import WorkList from "../components/WorkList.astro";
import { showcase } from "../system/compose";

const view = await showcase.getAboutView();
---
<BaseLayout meta={view.meta}>
  <section class="container profile">
    <img class="avatar" src={view.profile.avatar.src} alt={view.profile.avatar.alt} width="160" height="160" />
    <div>
      <h1>{view.profile.displayName}</h1>
      <p class="tagline">{view.profile.tagline}</p>
    </div>
    <div class="bio" set:html={view.profile.bio} />
  </section>

  <Section id="skills" heading="できること">
    {view.skillGroups.map((g) => (
      <div class="group">
        <h3>{g.name}</h3>
        <ul>
          {g.skills.map((s) => (
            <li><span class="name">{s.name}</span>{s.description && <span class="desc">{s.description}</span>}</li>
          ))}
        </ul>
      </div>
    ))}
  </Section>

  {view.works.length > 0 && (
    <Section id="works" heading="制作例" lead="受託・個人制作・サンプルの別をラベルで示しています。">
      <WorkList works={view.works} />
    </Section>
  )}
</BaseLayout>

<style>
  .profile {
    display: grid;
    gap: var(--space-4) var(--space-8);
    justify-items: center;
    padding-block: var(--space-12) var(--space-4);
    text-align: center;
  }
  @media (min-width: 48rem) {
    .profile {
      grid-template-columns: auto 1fr;
      justify-items: start;
      align-items: center;
      text-align: left;
    }
    .bio {
      grid-column: 1 / -1;
    }
  }
  .avatar {
    width: 8rem;
    height: 8rem;
    border-radius: var(--radius-full);
    border: 4px solid var(--color-surface);
    box-shadow: 0 4px 16px var(--color-shadow);
  }
  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.25rem);
  }
  .tagline {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
  }
  .bio {
    max-width: 40rem;
    text-align: left;
  }
  .group + .group {
    margin-top: var(--space-6);
  }
  h3 {
    margin: var(--space-4) 0 var(--space-2);
    font-size: 1.125rem;
  }
  ul {
    margin: 0;
    padding-left: 1.25rem;
  }
  li {
    margin-bottom: var(--space-1);
  }
  .name {
    font-weight: 700;
  }
  .desc {
    color: var(--color-text-muted);
  }
  .desc::before {
    content: "：";
  }
</style>
